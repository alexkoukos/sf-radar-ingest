# Copy to .env.local for local dev. In production these are set in the
# Vercel dashboard, not committed here.

# ── Client (shipped in the browser bundle) ────────────────────────────────
# The anon key is safe to ship - project RLS restricts it to SELECT on events.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only: Vercel functions (api/*). NEVER Vite-prefixed, never in the
#    client bundle. `grep` the built dist/ for these values - there must be none.
# Used by api/feed/* and api/group/*.
SUPABASE_URL=
# Service-role key - bypasses RLS. Required by api/group/* to reach the
# group tables (RLS ENABLEd, zero policies). Set in Vercel; only add locally
# if you run `vercel dev` against production.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for the signed group-session cookie (api/group/*). Any 32+ random
# bytes, e.g. `openssl rand -base64 48` or `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
GROUP_TOKEN_SECRET=
